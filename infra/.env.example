# =============================================================================
# DocuPro-V6 — variables de production (docupro-demo)
# Copier vers /home/deployer/docupro-demo.env (mode 600, propriétaire deployer).
# Ne jamais committer le fichier réel. Ne jamais réutiliser les secrets de .env.example
# Ne jamais réutiliser les secrets du .env.example local (JWT d'exemple, mot de passe Postgres de dev).
#
# Génération : infra/scripts/generate-prod-env.sh
# =============================================================================

# --- Runtime ---
NODE_ENV=production
PORT=3001

# --- PostgreSQL (conteneur docupro-demo-postgres, bind 127.0.0.1:5435) ---
POSTGRES_USER=docupro
POSTGRES_PASSWORD=CHANGE_ME_GENERATE
POSTGRES_DB=DocuPro
# Hôte = nom DNS du conteneur sur docupro-demo-network (pas localhost).
DATABASE_URL=postgresql://docupro:CHANGE_ME_GENERATE@docupro-demo-postgres:5432/DocuPro?schema=public

# --- Redis (interne, aucun port publié) ---
REDIS_URL=redis://docupro-demo-redis:6379

# --- Coffre disque (volume unique partagé api + worker) ---
# En production : /data/archives ← volume docupro-demo-archives-data.
# Ne PAS monter deux volumes distincts : l'API écrit, le worker lit (et inversement).
ARCHIVES_PATH=/data/archives

# --- Cachet serveur (Ed25519) ---
# Laissé vide : <ARCHIVES_PATH>/.keys/sealing-ed25519.pem, créé au premier scellement.
# IRREMPLAÇABLE : sans cette clé, tous les cachets déjà apposés deviennent invérifiables.
SEALING_KEY_PATH=

# Sauvegarde de la clé de scellement (à faire dès le premier scellement, et après) :
#   docker run --rm -v docupro-demo-archives-data:/data:ro alpine \
#     tar -czf - -C /data .keys > "$HOME/sealing-keys-docupro-demo-$(date +%F).tar.gz"
# Restauration (volume déjà créé, pile arrêtée) :
#   docker run --rm -i -v docupro-demo-archives-data:/data alpine \
#     tar -xzf - -C /data < "$HOME/sealing-keys-docupro-demo-YYYY-MM-DD.tar.gz"

# --- Auth ---
# openssl rand -hex 32  — jamais le JWT d'exemple du dépôt local.
JWT_SECRET=CHANGE_ME_GENERATE
JWT_EXPIRES_IN=1d

# --- Front / e-mails / CORS ---
APP_BASE_URL=https://docupro-demo.allianceconsultants.net
CORS_ORIGIN=https://docupro-demo.allianceconsultants.net

# Rewrite Next.js (conteneur web) vers l'API interne. Lu au `next start`.
API_INTERNAL_URL=http://docupro-demo-api:3001

# --- OCR (worker) ---
TESSERACT_LANG=fra+eng
# Pré-embarqué dans l'image worker. Laisser ainsi en production.
TESSERACT_DATA_PATH=/opt/tessdata

# --- Rappels Docu-Courriers ---
# Abidjan = UTC+0 ; le cron « 13h10 » est planifié dans ce fuseau.
REMINDERS_TZ=UTC
DELAIS_ALERTE_HOURS=48
DELAIS_ALERTE_INTERVAL_HOURS=6

# --- SMTP (optionnel) : vide = notifications in-app seulement ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_ORG_NAME=
MAIL_LOGO_URL=

# --- OpenAI (optionnel) : vide = saisie manuelle seulement ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# --- Agent de numérisation (postes de scan, pas le VPS) ---
# openssl rand -hex 24  — la même valeur va dans le .env de chaque agent.
SCAN_AGENT_API_KEY=CHANGE_ME_GENERATE
