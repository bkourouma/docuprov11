# --- Agent de numérisation DocuPro (poste de scan) ---------------------------
# Copiez ce fichier en « .env » À CÔTÉ de l'agent, sur le poste de numérisation.

# Racine de l'API, préfixe /api inclus. Remplacez par le nom ou l'IP du serveur.
SCAN_AGENT_API_URL="http://serveur-docupro:3001/api"

# Clé de service : LA MÊME valeur que SCAN_AGENT_API_KEY du .env du serveur.
# Aucun compte utilisateur, aucun mot de passe : une fois posée, plus personne ne saisit rien.
SCAN_AGENT_API_KEY="a-remplacer-par-la-cle-du-serveur"

# Repli pour un serveur antérieur à la clé de service : compte applicatif portant le menu
# « /courriers/documents-scannes ». Ignoré dès que SCAN_AGENT_API_KEY est renseignée.
#SCAN_AGENT_USERNAME="svc.scan"
#SCAN_AGENT_PASSWORD="a-remplacer"

# Dossier où le pilote du scanner dépose ses fichiers. Défaut : D:/scans-entrants.
# La racine du coffre (ARCHIVES_PATH) est refusée au démarrage : les binaires de la GED y sont
# stockés à plat et seraient sortis du coffre.
#SCAN_AGENT_WATCH_DIR="D:/scans-entrants"

# Colonne « Poste » de l'écran Documents scannés. Par défaut : nom de la machine.
#SCAN_AGENT_MACHINE_NAME="ACCUEIL-01"

# Cadence de balayage et délai de stabilité avant envoi (ms).
# Augmentez SCAN_AGENT_STABLE_MS si le scanner est lent ou le dossier sur un partage réseau.
#SCAN_AGENT_POLL_MS=5000
#SCAN_AGENT_STABLE_MS=4000

# Tentatives avant mise en quarantaine, et taille maximale acceptée (Mo).
#SCAN_AGENT_MAX_ATTEMPTS=5
#SCAN_AGENT_MAX_FILE_MB=100
