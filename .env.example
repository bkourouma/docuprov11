# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://archivage:29122003@localhost:5432/DocuPro?schema=public"

# --- Redis (BullMQ) ---
# 127.0.0.1 et non localhost : Redis n'ecoute que sur l'IPv4 (bind 127.0.0.1), donc
# "localhost" fait tenter ::1 en premier a chaque connexion pour rien.
REDIS_URL="redis://127.0.0.1:6379"

# --- File storage (binaries kept off-DB, named {file_id}{extension}) ---
# Coffre disque, cree automatiquement au demarrage (api + worker).
ARCHIVES_PATH="D:/ARCHIVES"

# --- Auth ---
JWT_SECRET="change-me-please-32-chars-minimum-secret"
JWT_EXPIRES_IN="1d"

# --- API ---
NODE_ENV="development"
PORT=3001

# --- Collaboration temps réel (éditeur natif) ---
# NEXT_PUBLIC_COLLAB_WS_URL : URL WebSocket du serveur de collaboration (ex. en dev :
#   ws://localhost:3001/api/collab). Si vide, l'URL est déduite de la page (même hôte,
#   ws:// ou wss:// selon http/https, chemin /api/collab). Valeur inlinée au build du web.
# NEXT_PUBLIC_COLLAB_WS_URL=
# COLLAB_TRUST_PROXY : nombre de sauts de proxy de confiance pour X-Forwarded-For
#   (0 ou vide = désactivé). Géré côté API.
# COLLAB_TRUST_PROXY=0

# --- Cachet serveur (signature + horodatage des documents) ---
# Clé privée Ed25519 (PEM) qui signe et horodate les documents, onglet « Sécurité et conformité ».
# Laissée vide : <ARCHIVES_PATH>/.keys/sealing-ed25519.pem, généré au premier scellement.
# À SAUVEGARDER : sans cette clé, les cachets déjà apposés deviennent invérifiables.
SEALING_KEY_PATH=""

# --- OCR (Tesseract) ---
TESSERACT_LANG="fra+eng"
# Optional: path to tessdata (CLI). Leave empty to use tesseract.js bundled data.
TESSERACT_DATA_PATH=""

# --- E-mail des notifications (§03.5) ---
# Sans SMTP_HOST, le canal e-mail est desactive : seules les notifications in-app partent.
# Port 465 = TLS implicite ; 587 = STARTTLS.
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
# Expediteur affiche (a defaut SMTP_USER).
SMTP_FROM=""
# Base des liens "Consulter le courrier" dans les e-mails.
APP_BASE_URL="http://localhost:5000"

# Identite affichee dans les e-mails de notification (facultatif).
# REPLI UNIQUEMENT : l'identite se parametre desormais en base, ecran "Paramétrage e-mail"
# (/admin/parametres/email). Ces variables ne servent plus que tant que rien n'y a ete saisi.
MAIL_ORG_NAME=""
# URL ABSOLUE du logo (une image relative ne s'affiche pas en boite mail).
MAIL_LOGO_URL=""

# --- Saisie automatique par IA (§05, écran d'enregistrement) ---
# Sans clé, la case « Saisie automatique » n'apparaît pas : la saisie reste manuelle.
OPENAI_API_KEY=

# Clé de service de l'agent de numérisation (postes de scan) — la même valeur va dans le .env de
# chaque agent. Laissée vide : aucune authentification par clé, l'agent doit alors utiliser un
# compte applicatif. Générer : node -e "console.log(require('node:crypto').randomBytes(36).toString('base64url'))"
# Voir docs/agent-scan-poste.md.
SCAN_AGENT_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# --- Connecteurs de sources GED (lot 2a) ---
# Aucune valeur ici : renseigner chaque variable dans le .env local, pour l'API ET pour le worker.
# Clé de chiffrement des identifiants des connecteurs : AES-256, 32 octets en base64.
# Générer : openssl rand -base64 32
# Obligatoire pour enregistrer des identifiants chiffrés (sans elle, l'API refuse en 503 et le worker met la passe en erreur).
# GED_CONNECTOR_KEY=
# Identifiant de la clé active, enregistré avec chaque ligne chiffrée. Défaut : k1.
# GED_CONNECTOR_KEY_ID=
# Rotation : anciennes clés, en déchiffrement seulement, au format id:base64,id:base64.
# Forme seulement : k1:<base64>,k0:<base64>
# GED_CONNECTOR_KEY_PREVIOUS=
# Racines autorisées du connecteur « dossier surveillé ». Séparateur : « ; » sous Windows, « : » ailleurs.
# Vide : tout chemin est refusé.
# GED_CONNECTOR_FS_ROOTS=
# Liste blanche d'exploitant (noms exacts, adresses ou CIDR) autorisant des hôtes internes pour l'IMAP.
# Vide par défaut : aucun hôte interne accepté.
# GED_CONNECTOR_ALLOWED_INTERNAL_HOSTS=
# Identifiants d'un connecteur, désignés par son credentials_ref : GED_CONNECTOR_SECRET_<NOM>.
# Valeur : objet JSON avec les champs attendus par le connecteur. Seul ce préfixe est accepté.
# GED_CONNECTOR_SECRET_<NOM>=

# --- Connecteurs OAuth (lot 2b) ---
# Aucune valeur ici : renseigner chaque variable dans le .env local, pour l'API ET pour le worker.
# Identifiant client OAuth Google (type « application web »). Utilisé par le connecteur Google Drive.
# GED_GOOGLE_CLIENT_ID=
# Secret client OAuth Google. Ne jamais le committer ni le journaliser.
# GED_GOOGLE_CLIENT_SECRET=
# Identifiant d'application (client) de l'inscription Microsoft Entra. Utilisé par OneDrive, SharePoint et Outlook.
# GED_MS_CLIENT_ID=
# Secret client Microsoft : sa valeur n'est affichée qu'une fois, à la création du secret.
# GED_MS_CLIENT_SECRET=
# Locataire Microsoft, obligatoire : identifiant de l'annuaire (GUID) ou nom de domaine du locataire.
# GED_MS_TENANT=
# URI de retour autorisées, séparées par des virgules, en correspondance exacte (https, ou http pour localhost et 127.0.0.1 seulement).
# Doit contenir l'URI de la page /connecteurs/oauth/callback de la GED.
# GED_OAUTH_REDIRECT_URIS=
# --- Lot 2c : connecteur WhatsApp Business (les secrets Meta se saisissent dans /connecteurs, chiffrés) ---
# Derrière UN proxy de confiance qui ajoute l'adresse du client à X-Forwarded-For : 1 (sinon ignoré).
# GED_WHATSAPP_TRUST_PROXY=
# Fenêtre anti-rejeu du webhook, en secondes (60 à 604800). Défaut : 3600.
# GED_WHATSAPP_REPLAY_WINDOW_SECONDS=
# Limites du webhook : requêtes par minute et par IP (défaut 300) ; messages par 10 minutes et par expéditeur (défaut 60).
# GED_WHATSAPP_IP_RATE_LIMIT=
# GED_WHATSAPP_SENDER_RATE_LIMIT=
